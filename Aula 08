#include <iostream>
using namespace std;

int main()
{
    char cadastro;
    float preco;
    int payday;

    do{ 
        cout << "Insira codigo de usuario.\n";
    cout << "Digite S para usuario cadastrado e N para nao cadastrado.\n";
    cin >> cadastro;
    if (cadastro != 'S' && cadastro != 'N' && cadastro != 's' && cadastro != 'n') {
    cout <<"\nInvalido, tente novamente!" <<endl; }
    } while(cadastro !='S' && cadastro != 'N' && cadastro !='s' && cadastro != 'n');
    
    cout << "Solicite o valor da sua venda:\n";
    cin >> preco;

    cout << "O valor eh " << preco << endl;

    if (cadastro == 'S' || cadastro == 's')
    {
        cout << "Voce eh cadastrado.\n";
        cout << "Voce tem acesso ao frete gratis e paga apenas: "
             << preco << endl;
    }
    else if (cadastro == 'N' || cadastro == 'n')
    {
        preco += 9.90;

        cout << "Voce nao eh cadastrado.\n";
        cout << "Voce deve pagar uma taxa de 9.90 pelo frete, resultando em: "
             << preco << endl;
    }
    else
    {
        cout << "Codigo invalido.\n";
        return 0;
    }

    do{
    cout << "\nQual a sua forma de pagamento?\n";
    cout << "1 - Pix\n";
    cout << "2 - Credito\n";
    cout << "3 - Debito\n";
    cout << "4 - Boleto\n";
    cin >> payday;
    if (payday != 1 && payday != 2 && payday != 3 && payday != 4) {
    cout <<"\nInvalido, tente novamente!" <<endl; }
    } while(payday !=1 && payday != 2 && payday !=3 && payday != 4);
    

    if (payday == 1)
    {
        cout << "Sua forma de pagamento eh o Pix.";
    }
    else if (payday == 2)
    {
        cout << "Sua forma de pagamento eh o Credito.";
    }
    else if (payday == 3)
    {
        cout << "Sua forma de pagamento eh o Debito.";
    }
    else if (payday == 4)
    {
        cout << "Sua forma de pagamento eh o Boleto.";
    }
    else
    {
        cout << "Forma de pagamento invalida.";
    }

    return 0;
}



