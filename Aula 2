// Primeiro programa
#include <iostream> //biblioteca de dados 
using namespace std; //uso do standart automatico
#define PRECO 12.90 //define o valor da variavel preco como 1.99

int main() {
        
        int pera = 3;
        char qualidade = 'A';
        float peso = 3.2;
        
        cout << "Existem " << pera << " Peras \nde qualidade " << qualidade
            << "\nPesando " << peso << " quilos." << endl;
        cout << "O preço por quilo eh R$ " << PRECO
            << "\no total eh R$ " << peso * PRECO << endl;
    return 0;
}


