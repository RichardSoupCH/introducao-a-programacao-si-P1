#include <iostream>
using namespace std;

int main()
{
    int opcao;

    cout << "===== MENU =====" << endl;
    cout << "1 - Classificar triangulo" << endl;
    cout << "2 - Calcular medias dos alunos" << endl;
    cout << "Escolha uma opcao: ";
    cin >> opcao;

    switch (opcao)
    {
    case 1:
    {
        int a1, a2, a3, resultado;

        do
        {
            cout << "Escreva o primeiro valor: ";
            cin >> a1;

            cout << "Escreva o segundo valor: ";
            cin >> a2;

            cout << "Escreva o terceiro valor: ";
            cin >> a3;

            resultado = a1 + a2 + a3;

            if (resultado > 180)
                cout << "Valores incorretos! A soma dos angulos nao pode ultrapassar 180 graus.\n";

            if (a1 <= 0 || a2 <= 0 || a3 <= 0)
            {
                cout << "Os angulos devem ser maiores que zero.\n";
                resultado = 181;
            }

        } while (resultado > 180);

        if (a1 == 90 || a2 == 90 || a3 == 90)
            cout << "Triangulo Retangulo\n";
        else if (a1 > 90 || a2 > 90 || a3 > 90)
            cout << "Triangulo Obtusangulo\n";
        else
            cout << "Triangulo Acutangulo\n";

        break;
    }

    case 2:
    {
        float nota1, nota2, media;

        for (int i = 1; i <= 10; i++)
        {
            do
            {
                cout << "Digite a primeira nota do aluno " << i << ": ";
                cin >> nota1;

                if (nota1 == 50)
                {
                    cout << "Programa encerrado." << endl;
                    return 0;
                }

                if (nota1 < 0 || nota1 > 50)
                    cout << "Nota invalida!" << endl;

            } while (nota1 < 0 || nota1 > 50);

            do
            {
                cout << "Digite a segunda nota do aluno " << i << ": ";
                cin >> nota2;

                if (nota2 == 50)
                {
                    cout << "Programa encerrado." << endl;
                    return 0;
                }

                if (nota2 < 0 || nota2 > 50)
                    cout << "Nota invalida!" << endl;

            } while (nota2 < 0 || nota2 > 50);

            media = (nota1 + nota2) / 2;

            cout << "Media do aluno " << i << ": " << media << endl << endl;
        }

        break;
    }

    default:
        cout << "Opcao invalida!" << endl;
    }

    return 0;
}
