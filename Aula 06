#include <iostream>
#include <cctype>
using namespace std;

int main()
{
    char cadastro;
    float preco;
    int payday;

    cout << "Insira codigo de usuario.\nDigite S para usuario cadastrado e N para nao cadastrado.\n";
    cin >> cadastro;

    cout << "Solicite o valor da sua venda\n";
    cin >> preco;

    cout << "O valor eh " << preco << endl;

    switch (cadastro)
    {
        case 'S':
            cout << "Voce eh cadastrado\n";
            cout << "Voce tem acesso ao frete gratis e paga apenas: "
                 << preco << endl;
            break;

        case 'N':
            preco += 9.90;
            cout << "Voce nao eh cadastrado\n";
            cout << "Voce deve pagar uma taxa de 9.90 pelo frete, resultando em: "
                 << preco << endl;
            break;

        default:
            cout << "Codigo invalido\n";
            return 0;
    }

    cout << "\nQual a sua forma de pagamento?\n";
    cout << "1-pix 2-credito 3-debito 4-boleto\n";
    cin >> payday;

    switch (payday)
    {
        case 1:
            cout << "Sua forma de pagamento eh o pix.";
            break;

        case 2:
            cout << "Sua forma de pagamento eh o credito.";
            break;

        case 3:
            cout << "Sua forma de pagamento eh o debito.";
            break;

        case 4:
            cout << "Sua forma de pagamento eh o boleto.";
            break;

        default:
            cout << "Forma de pagamento invalida.";
    }

    return 0;
}
